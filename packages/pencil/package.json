{
  "name": "@chengzhiyi/pi-pencil",
  "version": "0.0.1",
  "private": true,
  "description": "SPIKE: agent-assisted UI/UX design plugin for pi-webapp on open-pencil",
  "type": "module",
  "license": "MIT",
  "main": "./dist/runtime.js",
  "files": [
    "dist",
    "LICENSE",
    "NOTICE.txt",
    "README.md"
  ],
  "piWebapp": {
    "apiVersion": 2,
    "hostRange": ">=0.1.0",
    "runtimeProtocol": 1,
    "backend": {
      "entry": "./dist/runtime.js"
    },
    "frontend": {
      "document": "./dist/frame.html",
      "controller": "./dist/frame.html"
    },
    "resourcesManifest": "./dist/resources.json",
    "dataSchemaVersion": 1,
    "supportedDataSchemas": [
      1
    ],
    "capabilities": [
      "state",
      "workspace",
      "panels",
      "messages",
      "browser.wasm",
      "workspace.binary",
      "tool.images"
    ],
    "browser": {
      "wasm": true
    },
    "workspace": {
      "files": [
        {
          "extension": ".fig",
          "binary": true,
          "maxBytes": 67108864,
          "createDirectory": "designs"
        }
      ]
    },
    "runtime": {
      "invokeTimeoutMs": 120000
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test test/*.test.mjs",
    "probe": "node scripts/node-probe.mjs",
    "test:csp": "node test/csp.browser.mjs",
    "test:loop": "node test/loop.browser.mjs"
  },
  "devDependencies": {
    "@chengzhiyi/pi-web-protocol": "workspace:*",
    "@expo-google-fonts/noto-sans-sc": "0.4.4",
    "@open-pencil/core": "0.17.0-beta.2",
    "@open-pencil/kiwi": "0.17.0-beta.2",
    "@open-pencil/scene-graph": "0.17.0-beta.2",
    "@open-pencil/vue": "0.17.0-beta.2",
    "@playwright/test": "1.63.0",
    "@types/node": "22.19.19",
    "@vitejs/plugin-vue": "6.0.10",
    "canvaskit-wasm": "0.41.1",
    "esbuild": "0.28.2",
    "harfbuzzjs": "1.6.4",
    "lucide-vue-next": "1.0.0",
    "reka-ui": "2.11.0",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "vue": "3.5.45"
  }
}
