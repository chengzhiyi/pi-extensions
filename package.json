{
  "name": "pi-extensions",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.1",
  "scripts": {
    "build": "pnpm -r --filter './packages/**' build",
    "dev": "pnpm --parallel --filter './packages/**' dev",
    "check": "pnpm --filter @chengzhiyi/pi-web-protocol build && pnpm -r --filter './packages/**' check",
    "test": "pnpm --filter @chengzhiyi/pi-web-protocol build && node --test scripts/*.test.mjs && pnpm -r --filter './packages/**' test",
    "pack:check": "node scripts/pack.mjs",
    "release:plan": "node scripts/publish.mjs --plan",
    "release:prepare": "node scripts/publish.mjs --prepare",
    "release": "node scripts/publish.mjs --publish"
  },
  "devDependencies": {
    "jsdom": "26.1.0"
  }
}
